rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Set this custom claim only from a trusted Admin SDK environment.
    // Never let a client choose its own teacher role.
    function isTeacher() {
      return signedIn() && request.auth.token.teacher == true;
    }

    function isLinkedFamily(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.parentUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['parent', 'student']
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isTeacher();
    }

    match /students/{studentId} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isTeacher();
    }

    match /attendance/{recordId} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isTeacher();
    }

    match /payments/{paymentId} {
      allow read: if isTeacher() || (signedIn() && isLinkedFamily(resource.data.studentId));
      allow create, update, delete: if isTeacher();
    }

    match /marks/{markId} {
      allow read: if isTeacher() || (signedIn() && isLinkedFamily(resource.data.studentId));
      allow create, update, delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
