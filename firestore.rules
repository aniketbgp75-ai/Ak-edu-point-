rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Set this custom claim only from a trusted Admin SDK environment.
    // Never let a client choose its own teacher role.
    function isTeacher() {
      return signedIn() && request.auth.token.teacher == true;
    }

    function isLinkedFamily(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.parentUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      // A teacher's profile document may not exist on first login.
      // Permit the authenticated teacher to create/update only their own
      // profile document; teacher privileges still come exclusively from
      // the trusted Firebase custom claim checked by isTeacher().
      allow create: if (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role in ['parent', 'student']
          && request.resource.data.uid == uid)
        || (isTeacher()
          && request.auth.uid == uid
          && request.resource.data.uid == uid);
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid)
        || (isTeacher()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid);
      allow delete: if isTeacher();
    }

    match /users/{uid}/backups/{backupId} {
      allow read, write: if isTeacher() && request.auth.uid == uid;
    }

    match /users/{uid}/backups/{backupId}/{collection}/{recordId} {
      allow read, write: if isTeacher() && request.auth.uid == uid;
    }

    match /students/{studentId} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isTeacher();
    }

    match /attendance/{recordId} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isTeacher();
    }

    match /payments/{paymentId} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isTeacher();
    }

    match /marks/{markId} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
